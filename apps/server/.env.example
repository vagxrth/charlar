# ── Server ──────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── CORS ────────────────────────────────────────────────────
# Exact origins of the frontend (scheme + host + port), comma-separated.
# Dev: http://localhost:3000 | Prod: https://your-app.vercel.app
CORS_ORIGIN=http://localhost:3000
# Optional regular expression for origins you can't list ahead of time,
# such as Vercel preview deployments. It must match the whole origin.
CORS_ORIGIN_PATTERN=

# ── Sessions ────────────────────────────────────────────────
RECONNECT_TIMEOUT_MS=30000

# ── Logging ─────────────────────────────────────────────────
# pino level: fatal | error | warn | info | debug | trace
# Defaults to "info" in production, "debug" in development.
LOG_LEVEL=

# ── ICE / STUN / TURN ──────────────────────────────────────
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_SECRET=
# Seconds a TURN credential stays valid (4 h); keep it above your longest
# relayed call, since coturn won't refresh an expired one.
TURN_CREDENTIAL_TTL=14400
