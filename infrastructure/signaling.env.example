PORT=3001
NODE_ENV=production
CORS_ORIGIN=https://charlar.vagarth.in
# Optional: also allow Vercel preview deployments. The pattern must match
# the whole origin (no ^ or $ needed). Keep it this strict: a looser one,
# such as one that also fits branch URLs, can match other accounts' apps.
# CORS_ORIGIN_PATTERN=https://charlar-[a-z0-9]{9}-vagarth\.vercel\.app
RECONNECT_TIMEOUT_MS=30000
LOG_LEVEL=info

STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URLS=turn:api.charlar.vagarth.in:3478?transport=udp,turn:api.charlar.vagarth.in:3478?transport=tcp
TURN_SECRET=
# Seconds a TURN credential stays valid (4 h). Coturn won't refresh an
# allocation after its credential expires, so keep this above the longest
# relayed call you expect.
TURN_CREDENTIAL_TTL=14400
