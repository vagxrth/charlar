# Shared with backend — MUST match apps/server TURN_SECRET
TURN_SECRET=

# Realm used in TURN authentication
TURN_REALM=turn.example.com

# ── Addresses ───────────────────────────────────────────────
# Leave BOTH blank on a GCE VM. The entrypoint reads them from the cloud
# metadata server on every start, so an external IP that changes when the VM
# stops (ephemeral IPs are reassigned) can never go stale here. A stale value
# fails silently: only relayed calls break, and they break with no error.
#
# Set them explicitly when not on GCE, or when the host sits behind a load
# balancer whose public address differs from the instance's own.
#   TURN_EXTERNAL_IP  — public IP peers send relayed media to
#   TURN_LISTENING_IP — private IP coturn binds to
TURN_EXTERNAL_IP=
TURN_LISTENING_IP=

# Path to TLS cert and key inside the container (for TURNS on port 5349)
TURN_TLS_CERT=/etc/turn/certs/turn.crt
TURN_TLS_KEY=/etc/turn/certs/turn.key

# UDP relay port range
TURN_MIN_PORT=49152
TURN_MAX_PORT=65535
